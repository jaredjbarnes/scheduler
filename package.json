{
  "name": "@j13b/scheduler",
  "version": "0.1.0",
  "description": "A timezone-aware recurrence and dispatch engine: a pure-data rule DSL, IANA timezones, DST-aware generators and a cron-style dispatcher.",
  "license": "MIT",
  "author": "Jared J Barnes",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "tsconfig.json", "LICENSE", "README.md"],
  "scripts": {
    "build": "vite build && node scripts/build-cjs.mjs",
    "check:types": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepublishOnly": "npm run check:types && npm run test:run && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaredjbarnes/scheduler.git"
  },
  "homepage": "https://github.com/jaredjbarnes/scheduler#readme",
  "bugs": {
    "url": "https://github.com/jaredjbarnes/scheduler/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scheduler",
    "recurrence",
    "rrule",
    "calendar",
    "timezone",
    "dst",
    "cron",
    "dispatcher"
  ],
  "peerDependencies": {
    "@j13b/state": "^0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@j13b/state": "^0.2.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.4.0",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^4.1.9"
  }
}
